{
  "name": "sz-configtool",
  "version": "4.4.0-2",
  "description": "Typed Node.js/TypeScript binding (napi-rs) for manipulating Senzing configuration JSON (unofficial)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.node",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brianmacy/sz-rust-sdk-configtool",
    "directory": "bindings/node"
  },
  "napi": {
    "binaryName": "sz-configtool",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release --no-js",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.0",
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2"
  }
}
