<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.brianmacy</groupId>
  <artifactId>sz-configtool</artifactId>
  <!-- Keep equal to [workspace.package] version in the root Cargo.toml (a test checks). -->
  <version>4.4.0-3</version>
  <packaging>jar</packaging>
  <name>sz-configtool (Java)</name>
  <description>Unofficial Java binding (JNI) of the Senzing configuration library sz_configtool_lib</description>
  <url>https://github.com/brianmacy/sz-rust-sdk-configtool</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>6.1.3</junit.version>
    <!-- Workspace root (holds api/manifest and tests/fixtures). -->
    <workspace.dir>${project.basedir}/../..</workspace.dir>
    <!-- Where cargo put the JNI library: ${cargo.target.dir}/${native.profile}. -->
    <cargo.target.dir>${workspace.dir}/target</cargo.target.dir>
    <native.profile>release</native.profile>
    <native.lib.dir>${cargo.target.dir}/${native.profile}</native.lib.dir>
    <!-- Set by the OS profiles below; override with -Dnative.platform / -Dnative.lib.file. -->
    <native.platform>unknown</native.platform>
    <native.lib.file>libszconfigtool_jni.so</native.lib.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
      <!-- This host's freshly built JNI library -> natives/<os>-<arch>/<lib> in the jar. -->
      <resource>
        <directory>${native.lib.dir}</directory>
        <targetPath>natives/${native.platform}</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>${native.lib.file}</include>
        </includes>
      </resource>
      <!-- Prebuilt libraries for other platforms: natives/<os>-<arch>/<lib> (fat jar). -->
      <resource>
        <directory>${project.basedir}/natives</directory>
        <targetPath>natives</targetPath>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <useManifestOnlyJar>false</useManifestOnlyJar>
          <systemPropertyVariables>
            <szconfigtool.test.workspace>${workspace.dir}</szconfigtool.test.workspace>
            <szconfigtool.test.conformance>${workspace.dir}/api/manifest/generated/conformance.json</szconfigtool.test.conformance>
            <szconfigtool.test.manifest>${workspace.dir}/api/manifest/generated/manifest.json</szconfigtool.test.manifest>
            <szconfigtool.test.cargoToml>${workspace.dir}/Cargo.toml</szconfigtool.test.cargoToml>
            <szconfigtool.test.platform>${native.platform}</szconfigtool.test.platform>
            <szconfigtool.test.libFile>${native.lib.file}</szconfigtool.test.libFile>
            <szconfigtool.test.scratch>${project.build.directory}/test-scratch</szconfigtool.test.scratch>
            <!-- Extract into the build dir, never a shared tmp. -->
            <szconfigtool.native.dir>${project.build.directory}/natives-extracted</szconfigtool.native.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.brianmacy.szconfigtool</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>cargo-target-dir-env</id>
      <activation>
        <property>
          <name>env.CARGO_TARGET_DIR</name>
        </property>
      </activation>
      <properties>
        <cargo.target.dir>${env.CARGO_TARGET_DIR}</cargo.target.dir>
      </properties>
    </profile>
    <profile>
      <id>macos-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <native.platform>macos-aarch64</native.platform>
        <native.lib.file>libszconfigtool_jni.dylib</native.lib.file>
      </properties>
    </profile>
    <profile>
      <id>macos-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <native.platform>macos-x86_64</native.platform>
        <native.lib.file>libszconfigtool_jni.dylib</native.lib.file>
      </properties>
    </profile>
    <profile>
      <id>linux-x86_64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <native.platform>linux-x86_64</native.platform>
        <native.lib.file>libszconfigtool_jni.so</native.lib.file>
      </properties>
    </profile>
    <profile>
      <id>linux-aarch64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <native.platform>linux-aarch64</native.platform>
        <native.lib.file>libszconfigtool_jni.so</native.lib.file>
      </properties>
    </profile>
    <profile>
      <id>windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <native.platform>windows-x86_64</native.platform>
        <native.lib.file>szconfigtool_jni.dll</native.lib.file>
      </properties>
    </profile>
    <profile>
      <id>windows-aarch64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <native.platform>windows-aarch64</native.platform>
        <native.lib.file>szconfigtool_jni.dll</native.lib.file>
      </properties>
    </profile>
    <!-- `mvn -Pcoverage test`: JaCoCo line/branch coverage of the Java classes
         (target/site/jacoco/jacoco.xml). The gate is packaging/coverage.sh
         (coverage/policy.yaml); this profile only measures. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.15</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
